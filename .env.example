# Credenciais de deploy - FTP e SSH
# Preencha com os dados reais. Nao compartilhe nem versione o .env real.

# --- FTP ---
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_REMOTE_PATH=/

# --- SSH / SFTP ---
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=
SSH_PRIVATE_KEY_PATH=
SSH_REMOTE_PATH=/

# --- MySQL (Docker) ---
# IMPORTANTE: troque TODOS os "change_me" abaixo por valores reais e unicos
# antes de subir a stack. Se ficarem como estao, o banco, a assinatura de
# login (JWT_SECRET) e a senha do admin ficam previsiveis/adivinhaveis.
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=vx_hub
MYSQL_USER=vx_hub_user
MYSQL_PASSWORD=change_me
MYSQL_PORT=3306

# --- App (Docker) ---
APP_PORT=3000
JWT_SECRET=change_me_generate_a_random_hex_string

# --- Usuario admin criado automaticamente na 1a inicializacao ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me
